# ==============================================================================
# InsightSphere AI — Environment Variables
# ==============================================================================
# Copy this file to .env and configure your secret credentials:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Gemini LLM Settings
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model for reasoning, agent analysis, extraction validation, and summarization
GEMINI_MODEL=gemini-1.5-flash

# Advanced reasoning model for deep cross-source synthesis and comprehensive reports
GEMINI_PRO_MODEL=gemini-1.5-pro

# Model sampling temperature (0.0 to 1.0)
GEMINI_TEMPERATURE=0.7

# Max tokens generated per model response
GEMINI_MAX_OUTPUT_TOKENS=2048

# ------------------------------------------------------------------------------
# 2. Embedding Settings (RAG Pipeline)
# ------------------------------------------------------------------------------
# Gemini embedding model for chunk indexing and vector similarity search
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Embedding vector dimension (768 for text-embedding-004)
EMBEDDING_DIMENSION=768
